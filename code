      <circle cx="90" cy="25" r="5" fill="#d9a441" opacity="0.6"/>
    </svg>`,
    sound: { type: "hum" }
  },
  {
    name: "Singe",
    svg: `
    <svg viewBox="0 0 200 180">
      <circle cx="100" cy="100" r="60" fill="#8b5a2b"/>
      <circle cx="100" cy="105" r="40" fill="#e8c39e"/>
      <circle cx="80" cy="95" r="5" fill="#222"/>
      <circle cx="120" cy="95" r="5" fill="#222"/>
      <ellipse cx="100" cy="118" rx="15" ry="10" fill="#d1a479" class="nose" data-part="nose"/>
      <circle cx="94" cy="118" r="2.5" fill="#5c3a21"/>
      <circle cx="106" cy="118" r="2.5" fill="#5c3a21"/>
      <path d="M85 135 Q100 145 115 135" stroke="#5c3a21" stroke-width="2" fill="none"/>
      <circle cx="55" cy="90" r="18" fill="#8b5a2b"/>
      <circle cx="145" cy="90" r="18" fill="#8b5a2b"/>
      <circle cx="55" cy="90" r="10" fill="#e8c39e"/>
      <circle cx="145" cy="90" r="10" fill="#e8c39e"/>
    </svg>`,
    sound: { type: "monkey" }
  },
  {
    name: "Rhinocéros",
    svg: `
    <svg viewBox="0 0 200 180">
      <ellipse cx="100" cy="100" rx="70" ry="55" fill="#8c9a8c"/>
      <ellipse cx="100" cy="100" rx="70" ry="55" fill="none" stroke="#6b786b" stroke-width="2"/>
