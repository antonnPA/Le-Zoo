      <ellipse cx="100" cy="120" rx="13" ry="9" fill="#2b2b2b" class="nose" data-part="nose"/>
    </svg>`,
    sound: { type: "sneeze" }
  },
  {
    name: "Tigre",
    svg: `
    <svg viewBox="0 0 200 180">
      <circle cx="100" cy="100" r="65" fill="#e8841f"/>
      <circle cx="100" cy="105" r="42" fill="#fcead0"/>
      <path d="M50 70 L30 50 M60 60 L45 35 M140 60 L155 35 M150 70 L170 50" stroke="#222" stroke-width="4" stroke-linecap="round"/>
      <path d="M75 60 L65 40 M125 60 L135 40" stroke="#222" stroke-width="4" stroke-linecap="round"/>
      <circle cx="78" cy="90" r="5" fill="#222"/>
      <circle cx="122" cy="90" r="5" fill="#222"/>
      <ellipse cx="100" cy="112" rx="12" ry="8" fill="#5c2e0e" class="nose" data-part="nose"/>
      <path d="M90 118 Q100 128 110 118" stroke="#333" stroke-width="2" fill="none"/>
      <path d="M65 112 L35 108 M65 118 L33 122 M65 124 L37 133" stroke="#333" stroke-width="1.5"/>
      <path d="M135 112 L165 108 M135 118 L167 122 M135 124 L163 133" stroke="#333" stroke-width="1.5"/>
    </svg>`,
    sound: { type: "tiger" }
  },
  {
    name: "Zèbre",
    svg: `
    <svg viewBox="0 0 200 180">
      <ellipse cx="100" cy="105" rx="60" ry="50" fill="#fdfdfd"/>
      <path d="M60 70 Q100 60 140 70 M55 90 Q100 80 145 90 M58 110 Q100 100 142 110 M65 130 Q100 122 135 130" stroke="#222" stroke-width="7" fill="none" stroke-linecap="round"/>
      <circle cx="78" cy="80" r="4.5" fill="#222"/>
      <circle cx="122" cy="80" r="4.5" fill="#222"/>
      <ellipse cx="100" cy="120" rx="14" ry="9" fill="#444" class="nose" data-part="nose"/>
      <ellipse cx="55" cy="60" rx="9" ry="14" fill="#fdfdfd" stroke="#222" stroke-width="2"/>
      <ellipse cx="145" cy="60" rx="9" ry="14" fill="#fdfdfd" stroke="#222" stroke-width="2"/>
    </svg>`,
    sound: { type: "zebra" }
