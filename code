<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Doigts dans le nez du Zoo 🐾</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: 'Comic Sans MS', 'Trebuchet MS', sans-serif;
    background: linear-gradient(135deg, #a8e063, #56ab2f);
    min-height: 100vh;
    text-align: center;
    padding: 20px;
  }
  h1 {
    color: #fff;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    font-size: 2.2em;
    margin-bottom: 5px;
  }
  .subtitle {
    color: #f0fff0;
    margin-bottom: 10px;
    font-size: 1.1em;
  }
  .counter {
    background: #fff;
    display: inline-block;
    padding: 10px 25px;
    border-radius: 30px;
    font-weight: bold;
    color: #2d6a1e;
    font-size: 1.3em;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    margin-bottom: 25px;
  }
  .zoo {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 25px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .animal-card {
    background: #fff;
    border-radius: 20px;
    padding: 15px;
    width: 220px;
    box-shadow: 0 6px 15px rgba(0,0,0,0.25);
    transition: transform 0.2s;
    position: relative;
    overflow: hidden;
  }
  .animal-card:hover {
    transform: translateY(-5px) scale(1.03);
  }
  .animal-name {
    font-weight: bold;
    color: #444;
    margin-top: 8px;
    font-size: 1.1em;
  }
  svg {
    width: 100%;
    height: 180px;
  }
  .nose {
    cursor: pointer;
    transition: transform 0.1s;
  }
  .nose:hover {
    filter: brightness(1.15);
  }
  .reaction {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    background: #fff176;
    padding: 6px 14px;
    border-radius: 15px;
    font-weight: bold;
    font-size: 0.95em;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    z-index: 10;
  }
  .reaction.show {
    animation: popup 1.1s ease forwards;
  }
  @keyframes popup {
    0% { opacity: 0; transform: translateX(-50%) translateY(10px) scale(0.5); }
    20% { opacity: 1; transform: translateX(-50%) translateY(-10px) scale(1.2); }
    35% { transform: translateX(-50%) translateY(-5px) scale(1); }
    80% { opacity: 1; }
    100% { opacity: 0; transform: translateX(-50%) translateY(-30px) scale(0.9); }
  }
  .shake {
    animation: shakeAnim 0.4s ease;
  }
  @keyframes shakeAnim {
    0%, 100% { transform: translateX(0) rotate(0deg); }
    20% { transform: translateX(-4px) rotate(-2deg); }
    40% { transform: translateX(4px) rotate(2deg); }
    60% { transform: translateX(-3px) rotate(-1deg); }
    80% { transform: translateX(3px) rotate(1deg); }
  }
  footer {
    margin-top: 40px;
    color: #eaffea;
    font-size: 0.9em;
    padding-bottom: 20px;
  }
  .finger {
    position: absolute;
    font-size: 30px;
    pointer-events: none;
    opacity: 0;
    z-index: 20;
  }
  .finger.animate {
    animation: fingerPoke 0.6s ease forwards;
  }
  @keyframes fingerPoke {
    0% { opacity: 0; transform: translateY(20px) scale(0.5) rotate(90deg); }
    40% { opacity: 1; transform: translateY(-5px) scale(1) rotate(90deg); }
    60% { transform: translateY(-5px) scale(1.1) rotate(90deg); }
    100% { opacity: 0; transform: translateY(-15px) scale(0.8) rotate(90deg); }
  }
</style>
</head>
<body>

<h1>🐾 Doigts dans le Nez du Zoo 🐾</h1>
<p class="subtitle">Clique sur le nez de chaque animal pour l'explorer... avec style !</p>
<div class="counter">👉 Nez explorés : <span id="count">0</span></div>

<div class="zoo" id="zoo"></div>

<footer>
  Fait avec 💚 et beaucoup (beaucoup) trop d'imagination. Ne pas essayer sur un vrai animal. 😄
</footer>

<script>
let count = 0;
const countEl = document.getElementById('count');

const reactions = [
  "Miam ? Beurk !",
  "Ça chatouille !",
  "Argh, sors de là !",
  "Oh non, pas encore !",
  "Chouette découverte...",
  "Pouah, c'est dégoutant !",
  "Encore ?!",
  "Ah ah, ça fait du bien !"
];

// Définition des animaux avec SVG amélioré + fréquence sonore de base
const animals = [
