      <ellipse cx="75" cy="90" rx="16" ry="20" fill="#2b2b2b"/>
      <ellipse cx="125" cy="90" rx="16" ry="20" fill="#2b2b2b"/>
      <circle cx="75" cy="92" r="5" fill="#fff"/>
