      <ellipse cx="55" cy="95" rx="10" ry="15" fill="#8c9a8c" stroke="#6b786b" stroke-width="2"/>
      <ellipse cx="145" cy="95" rx="10" ry="15" fill="#8c9a8c" stroke="#6b786b" stroke-width="2"/>
    </svg>`,
    sound: { type: "grunt" }
  },
  {
    name: "Hippopotame",
    svg: `
    <svg viewBox="0 0 200 180">
      <ellipse cx="100" cy="110" rx="75" ry="50" fill="#b05c6b"/>
      <ellipse cx="100" cy="110" rx="75" ry="50" fill="none" stroke="#8a4350" stroke-width="2"/>
      <circle cx="65" cy="85" r="10" fill="#b05c6b" stroke="#8a4350" stroke-width="2"/>
      <circle cx="135" cy="85" r="10" fill="#b05c6b" stroke="#8a4350" stroke-width="2"/>
      <circle cx="65" cy="85" r="4" fill="#222"/>
      <circle cx="135" cy="85" r="4" fill="#222"/>
      <ellipse cx="100" cy="125" rx="28" ry="16" fill="#9c4e5c" class="nose" data-part="nose"/>
      <circle cx="90" cy="122" r="3.5" fill="#333"/>
      <circle cx="110" cy="122" r="3.5" fill="#333"/>
    </svg>`,
    sound: { type: "hippo" }
  },
  {
    name: "Panda",
    svg: `
    <svg viewBox="0 0 200 180">
      <circle cx="100" cy="100" r="62" fill="#fdfdfd" stroke="#ddd" stroke-width="2"/>
      <circle cx="55" cy="55" r="20" fill="#2b2b2b"/>
